# --------------------------------------------------------------------
# ENVIRONMENT
# --------------------------------------------------------------------
CI_ENVIRONMENT = production

# --------------------------------------------------------------------
# APP
# --------------------------------------------------------------------
app.baseURL = 'https://your-domain.example/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = false
app.demo = false

# --------------------------------------------------------------------
# DATABASE
# --------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = your_hostinger_db_name
database.default.username = your_hostinger_db_user
database.default.password = 'YOUR_STRONG_DB_PASSWORD'
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.DBPrefix = ''

# --------------------------------------------------------------------
# SECURITY & ENCRYPTION
# --------------------------------------------------------------------
# Use a unique 32+ char key per environment.
encryption.key = REPLACE_WITH_UNIQUE_32_PLUS_CHAR_KEY

# --------------------------------------------------------------------
# SESSION
# --------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = writable/session
session.cookieName = 'ci_session_saas'
app.sessionCookieName = ci_session_saas
session.expiration = 7200
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

# --------------------------------------------------------------------
# API
# --------------------------------------------------------------------
API_V1_SESSION_BRIDGE_SEARCH = true
