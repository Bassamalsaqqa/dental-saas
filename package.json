{
  "name": "dental",
  "version": "1.0.0",
  "description": "Denta+ multi-tenant dental clinic application with native CodeIgniter PHP and Studio interfaces.",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./public/assets/css/tailwind.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./public/assets/css/tailwind.css --minify",
    "build-css": "tailwindcss -i ./src/input.css -o ./public/assets/css/tailwind.css",
    "build-css-prod": "tailwindcss -i ./src/input.css -o ./public/assets/css/tailwind.css --minify",
    "release:hostinger": "powershell -ExecutionPolicy Bypass -File ./scripts/release-hostinger.ps1",
    "test": "npm run test:unit",
    "test:unit": "php vendor/phpunit/phpunit/phpunit --no-coverage --no-logging --do-not-cache-result tests/unit/FinanceArabicIntegrityTest.php tests/unit/BookingResourcePresenterTest.php tests/unit/FinanceSalaryProviderAccountingTest.php tests/unit/FinanceSettlementProviderCurrencyTest.php tests/unit/FinanceSettlementServiceTest.php tests/unit/FinanceSettlementInputGuardTest.php tests/unit/FinanceTreasuryServiceTest.php tests/unit/SafeTestConnectionBootstrapTest.php tests/unit/HostingerContainmentHelperTest.php tests/unit/PatientWorkflowBoundaryTest.php tests/unit/PatientNavigationHarnessSecurityTest.php tests/unit/DeveloperSandboxPreflightTest.php tests/unit/DeveloperSandboxTrialControllerTest.php",
    "test:finance:http": "php scripts/safe_test_runner.php --no-coverage --no-logging --do-not-cache-result tests/unit/FinanceSalaryWorkflowHttpTest.php"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bassamalsaqqa/dental-saas.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Bassamalsaqqa/dental-saas/issues"
  },
  "homepage": "https://github.com/Bassamalsaqqa/dental-saas#readme",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "baseline-browser-mapping": "^2.9.19",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0"
  },
  "private": true,
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
